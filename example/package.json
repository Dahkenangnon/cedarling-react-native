{
  "name": "cedarling-react-native-example",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "cedarling-react-native": "file:..",
    "expo": "~57.0.15",
    "expo-asset": "~57.0.13",
    "expo-build-properties": "~57.0.13",
    "react": "19.2.3",
    "react-native": "0.86.2"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.7",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "test:android": "cd android && ./gradlew testDebugUnitTest",
    "test:android:instrumented": "cd android && ./gradlew connectedDebugAndroidTest",
    "build:release": "cd android && ./gradlew assembleRelease bundleRelease",
    "build:ios": "xcodebuild -workspace ios/CedarlingReactNativeExample.xcworkspace -scheme CedarlingReactNativeExample -sdk iphonesimulator CODE_SIGNING_ALLOWED=NO build"
  },
  "private": true,
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
