{
  "name": "cedarling-react-native",
  "version": "0.1.0",
  "description": "Android-first Expo module for embedded Jans Cedarling authorization",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "node internal/module_scripts/test.js --runInBand",
    "test:android": "npm --prefix example run test:android",
    "test:android:instrumented": "npm --prefix example run test:android:instrumented",
    "verify:android-artifacts": "bash scripts/verify-android-artifacts.sh",
    "build:policy-fixture": "bash scripts/build-policy-fixture.sh",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:android": "node internal/module_scripts/open-android.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "cedarling",
    "authorization",
    "android",
    "expo-module"
  ],
  "author": "Janssen Project Contributors",
  "license": "Apache-2.0",
  "files": [
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/cedarling-native",
    "android/maven",
    "android/libs",
    "android/src/main",
    "build",
    "src/*.ts",
    "expo-module.config.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.7",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "expo": "^57.0.15",
    "expo-modules-core": "~57.0.12",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "prettier": "^3.0.0",
    "react-native": "0.86.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "roots": [
      "<rootDir>/src"
    ]
  },
  "peerDependencies": {
    "expo": "*",
    "react": "*",
    "react-native": "*"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
