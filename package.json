{
  "name": "cedarling-react-native",
  "version": "0.1.0",
  "description": "React Native TurboModule for embedded Jans Cedarling authorization on Android and iOS",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "scripts": {
    "build": "node internal/module_scripts/build.js",
    "clean": "node internal/module_scripts/clean.js",
    "lint": "eslint src/ demo/",
    "typecheck": "tsc --noEmit",
    "test": "node internal/module_scripts/test.js --runInBand",
    "codegen": "react-native codegen --path . --platform all",
    "test:android": "npm --prefix example run test:android",
    "test:android:instrumented": "npm --prefix example run test:android:instrumented",
    "verify:android-artifacts": "bash scripts/verify-android-artifacts.sh",
    "verify:ios-artifacts": "bash scripts/verify-ios-artifacts.sh",
    "verify:native-pins": "bash scripts/verify-native-pin.sh",
    "verify:autolinking": "node scripts/verify-autolinking.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "build:policy-fixture": "bash scripts/build-policy-fixture.sh",
    "prepare": "node internal/module_scripts/prepare.js",
    "open:android": "node internal/module_scripts/open-android.js",
    "open:ios": "node internal/module_scripts/open-ios.js"
  },
  "keywords": [
    "react-native",
    "expo",
    "cedarling",
    "authorization",
    "android",
    "ios",
    "turbomodule"
  ],
  "author": "Janssen Project Contributors",
  "license": "Apache-2.0",
  "files": [
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/cedarling-native",
    "android/maven",
    "android/libs",
    "android/src/main",
    "ios/*.h",
    "ios/*.mm",
    "ios/*.swift",
    "ios/generated",
    "ios/CedarlingNative.xcframework",
    "ios/cedarling-native",
    "build",
    "src/*.ts",
    "CedarlingReactNative.podspec",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/jest": "^29.2.1",
    "@react-native-community/cli": "20.1.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@types/react": "~19.2.2",
    "eslint": "~9.39.4",
    "eslint-config-universe": "^15.0.3",
    "jest": "^29.7.0",
    "prettier": "^3.0.0",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/demo"
    ]
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "codegenConfig": {
    "name": "CedarlingReactNativeSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "expo.modules.cedarling"
    }
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
